# Morph's service (local: npm run dev at the repo root starts it on 8787)
MORPH_URL=http://localhost:8787
# Ledgerly's secret key from `morph admin create-tenant` (npm run setup:local writes it for you)
MORPH_SECRET_KEY=sk_...
# Signs Ledgerly's own login cookie
SESSION_SECRET=dev-only-session-secret-change-me
