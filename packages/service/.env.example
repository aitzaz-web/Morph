# Postgres (docker compose up -d postgres starts one on port 5433)
DATABASE_URL=postgres://morph:morph@localhost:5433/morph

# Signs session tokens. Generate with: openssl rand -base64 48
MORPH_JWT_SECRET=...
# For the admin API (creating companies). Generate with: openssl rand -base64 32
MORPH_ADMIN_KEY=...

# One of these (OpenAI is used if both are set, unless MORPH_PROVIDER says otherwise)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional
# MORPH_PROVIDER=openai        # openai | anthropic
# OPENAI_MODEL=gpt-6.1-sol
# MORPH_EFFORT=medium          # low | medium | high
# PORT=8787
