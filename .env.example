# Provide one of these (OpenAI is used if both are set, unless MORPH_PROVIDER says otherwise)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional
# OPENAI_MODEL=gpt-6.1-sol
# MORPH_PROVIDER=openai        # openai | anthropic
# MORPH_EFFORT=low             # low | medium | high (reasoning effort; low = snappier chat)
