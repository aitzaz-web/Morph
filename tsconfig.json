{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@company": [
        "./src/morph/company.tsx"
      ],
      "@morph": [
        "./src/morph/sdk.tsx"
      ]
    }
  },
  "include": [
    "src",
    "shared",
    "server",
    "scripts"
  ]
}
